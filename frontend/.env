# Committed defaults. Build-time config (Vite exposes only VITE_* to the browser). None of these are secrets.
# Override locally in .env.local (gitignored); CI injects real values from GitHub repo variables.
VITE_GOOGLE_CLIENT_ID=
VITE_GA_ID=
# Search Console "HTML tag" verification token (content value only)
VITE_GSC_VERIFICATION=
